      background-position: 0 0, 15px 15px;
      background-opacity: 0.05;
    }

    .persian-gold-border {
      border: 1px solid rgba(197, 160, 89, 0.4);
      position: relative;
    }

    .persian-corner-frame {
      position: relative;
    }
    .persian-corner-frame::before, .persian-corner-frame::after {
      content: "";
      position: absolute;
      width: 14px;
      height: 14px;
      pointer-events: none;
      border-color: #C5A059;
    }
    .persian-corner-frame::before {
      top: 6px;
      left: 6px;
      border-top: 2px solid #C5A059;
      border-left: 2px solid #C5A059;
    }
    .persian-corner-frame::after {
      bottom: 6px;
      right: 6px;
      border-bottom: 2px solid #C5A059;
      border-right: 2px solid #C5A059;
    }

