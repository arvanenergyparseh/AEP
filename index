    let currentLang = 'en';

    function toggleLanguage() {
      currentLang = currentLang === 'en' ? 'fa' : 'en';
      const htmlEl = document.documentElement;
      const langLabel = document.getElementById('langLabel');

      if (currentLang === 'fa') {
        htmlEl.setAttribute('lang', 'fa');
        htmlEl.setAttribute('dir', 'rtl');
        langLabel.textContent = 'English / EN';
      } else {
        htmlEl.setAttribute('lang', 'en');
        htmlEl.setAttribute('dir', 'ltr');
        langLabel.textContent = 'فارسی / FA';
      }

      // Update text for all elements with data-i18n
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (translations[currentLang][key]) {
          el.innerHTML = translations[currentLang][key];
        }
      });
    }

    function toggleMobileMenu() {
      const menu = document.getElementById('mobileMenu');
      menu.classList.toggle('hidden');
    }

    function handleInquirySubmit(event) {
      event.preventDefault();
      const form = document.getElementById('tradeInquiryForm');
      const msg = document.getElementById('formSuccessMessage');
      
      msg.classList.remove('hidden');
      form.reset();

      setTimeout(() => {
        msg.classList.add('hidden');
      }, 7000);
    }
  </script>

